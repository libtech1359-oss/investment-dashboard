# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=
CEO_CHANNEL=ai-v2秘書
REPORT_CHANNEL=ai-v2秘書

# Google Apps Script Web App URL（v2専用）
# デプロイ後に取得する「ウェブアプリのURL」を貼り付ける
#
# GASコードを更新した場合のデプロイ手順（URLを固定するため --deploymentId 必須）:
#   cp gas-v2.gs gas-deploy/gas-v2.gs
#   clasp push
#   clasp deploy --deploymentId <現在のID> --description "説明"
#   # .env の GAS_V2_URL は変わらないので更新不要
#
# 現在のdeploymentId は `clasp deployments` で確認、または .env.current_deployment に記録
GAS_V2_URL=

# Ollama（v1と同じ設定でOK）
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# 財務戦略部（非公開・隠し部署）— config/financeStrategy.js
# true にすると現金残高に関わらず即座に解放（「AI Capital 組織改編」実施時に使用）
FINANCE_STRATEGY_ENABLED=false
# 現金残高がこの金額（円）に到達すると自動的に解放（未設定時は3,000,000）
FINANCE_STRATEGY_CASH_THRESHOLD=3000000

# 開発ログ自動記録（scripts/auto-devlog.js — git post-commitフックから起動）
# デフォルト（未設定 = false）: config/systemVersion.json / CHANGELOG.md / development_logs
#   への保存までを自動で行い、実際の git commit は人が行う（「コミット可能です」通知のみ）。
# true にすると、上記2ファイル（config/systemVersion.json, CHANGELOG.md）のみを対象に
#   自動でコミットするようになる（将来の完全無人運転向けオプション。通常運用ではfalse推奨）。
AUTO_COMMIT=false
