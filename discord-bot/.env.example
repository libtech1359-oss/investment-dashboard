# ─────────────────────────────────────────
# Discord Bot 設定（このファイルを .env にコピーして値を入力）
# ─────────────────────────────────────────

# Discord Developer Portal → アプリ → Bot → Token
DISCORD_TOKEN=ここにBotトークンを貼り付け

# Discord Developer Portal → アプリ → General Information → Application ID
CLIENT_ID=ここにアプリケーションIDを貼り付け

# Discord サーバーID（サーバー名を右クリック → IDをコピー）
GUILD_ID=ここにサーバーIDを貼り付け

# GAS エンドポイント（dashboard.html の SHEET_API_URL と同じ値）
GAS_URL=https://script.google.com/macros/s/AKfycbwC0_Vq8K1cs48SCrXr2gmDYeLLDmKvaSCU-vOGyxR0OEGFXDIvF4-upXj798bj2eUB/exec

# ─────────────────────────────────────────
# AI音声秘書 設定（任意）
# ─────────────────────────────────────────

# 自動参加するボイスチャンネルのID（VCチャンネルを右クリック → IDをコピー）
# 設定しない場合はVC機能をスキップ
VOICE_CHANNEL_ID=1505424483958263999

# AIが反応するテキストチャンネル名（デフォルト: ai秘書）
# AI_CHANNEL_NAME=ai秘書

# Ollamaで使うモデル名（デフォルト: gemma4:e4b）
# OLLAMA_MODEL=gemma4:e4b

# VOICEVOX エンジンのURL（デフォルト: http://127.0.0.1:50021）
# VOICEVOX_URL=http://127.0.0.1:50021

# VOICEVOX 話者ID（デフォルト: 1 = 四国めたん あまあま）
# VOICEVOX_SPEAKER=1
